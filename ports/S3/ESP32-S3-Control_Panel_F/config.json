{
    "_comment": "S3 控制面板裝置（LCD + encoder + 按鍵 + LVGL）。對外通訊走 ESP-NOW；本板無本地燈效硬體。",
    "scan_ignore": ["/sd"],
    "System": {
        "dual_core_mode": 0,
        "boot_strict": 0,
        "hostname": "s3-cpanel",
        "cID": "0001",
        "debug_level": 1,
        "master_IP": "",
        "master_port": 0,
        "discovery_port": 9000,
        "ws_stale_ms": 30000,
        "heartbeat_interval": 10000,
        "frame_interval_ms": 20,
        "num_pixels": 336,
        "log_interval_ms": 1000,
        "watchdog": {
            "enable": 0,
            "timeout_ms": 8000,
            "btn_bypass_gpio": -1,
            "auto_rearm_ms": 0
        }
    },
    "Buffer": {
        "drop_on_full": 1,
        "drain_reads": 1,
        "u8_rx_slots": 8
    },
    "Network": {
        "priority": ["lan", "wifi"],
        "lan": {
            "enable": 0,
            "active_mode": 1,
            "driver": "RMII",
            "phy_addr": 1,
            "phy_type": "IP101",
            "GPIO": {
                "mdc": -1, "mdio": -1, "ref_clk": -1,
                "spi": -1, "cs": -1, "rst": -1, "int": -1
            }
        },
        "wifi": {
            "enable": 0,
            "active_mode": 2,
            "timeout": 300,
            "ssid": "Home_WiFi",
            "ssid_pw": "",
            "mdns_name": "esp32-led-"
        },
        "ESP_now": { "enable": 1, "channel": 6 }
    },
    "Router": {
        "enable": 1,
        "routes": [
            { "in": "self",  "out": ["now"] },
            { "in": "now",   "out": ["self"] },
            { "in": "net",   "out": ["self"] },
            { "in": "udp",   "out": [] },
            { "in": "uart0", "out": [] }
        ]
    },

    "SPI": {
        "enable": 1,
        "list": [
            {
                "id": 1,
                "baudrate": 80000000,
                "phase": 0,
                "polarity": 0,
                "GPIO": { "sck": 21, "mosi": null, "miso": null },
                "data_pins": [14]
            },
            {
                "id": 2,
                "baudrate": 30000000,
                "phase": 0,
                "polarity": 0,
                "GPIO": { "sck": 8, "mosi": null, "miso": null },
                "data_pins": [9]
            }
        ]
    },
    "I2C": {
        "enable": 1,
        "list": [
            { "id": 0, "freq": 400000, "GPIO": { "scl": 18, "sda": 17 } }
        ]
    },
    "UART": {
        "enable": 0,
        "list": [
            { "id": 1, "baudrate": 115200, "GPIO": { "tx": 39, "rx": 41 } }
        ]
    },
    "PWM": {
        "enable": 0,
        "list": []
    },
    "I2S": {
        "enable": 0,
        "list": []
    },
    "SDcard": {
        "enable": 1,
        "phat": "/sd",
        "config": { "slot": 0, "width": 4, "freq": 40000000 },
        "GPIO": {
            "_comment": "sck=CLK/SCK, cmd=CMD/MOSI, [D0/MISO, D1/IRQ, D2/NC, D3/CS]",
            "sck": 7, "cmd": 6, "data": [15, 16, 4, 5]
        }
    },
    "PIN": {
        "enable": 1,
        "list": [
            { "GPIO": 11, "label": "tft_cs",  "mode": "OUT", "initial": 1 },
            { "GPIO": 12, "label": "tft_dc",  "mode": "OUT", "initial": 0 },
            { "GPIO": 13, "label": "tft_rst", "mode": "OUT", "initial": 1 },
            { "GPIO": 10, "label": "tft_bl",  "mode": "OUT", "initial": 0 },
            { "GPIO": 2, "label": "encC",    "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 1, "label": "btn",     "mode": "IN",  "initial": 0, "pull": "UP" }
        ]
    },
    "ENC": {
        "enable": 1,
        "list": [
            { "id": 0, "GPIO": { "a": 41, "b": 42 } }
        ]
    },
    "TFT": {
        "enable": 1,
        "driver": "ST7789",
        "width": 240,
        "height": 320,
        "rotation": 0,
        "color_order": "RGB",
        "invert": 0,
        "spi_id": 1,
        "pixel_format": "RGB565_BE",
        "variant": 0,
        "pins": { "dc": "tft_dc", "cs": "tft_cs", "rst": "tft_rst", "bl": "tft_bl" }
    },

    "HUSB238": {
        "enable": 0,
        "addr": "0x08",
        "default_voltage": null,
        "GPIO": { "i2c": 0 }
    },
    "WS2812": {
        "enable": 1,
        "list": [
        {"GPIO": 3, "Q": 2000, "order": "GRB", "dStay": 0}
        ]
    },

    "APA102": {
        "enable": 1,
        "list": [
        {"GPIO": {"spi": 1}, "Q": 2000, "order": "BGRW", "dStay": 0}
        ]
    },

    "PCA9685": {
        "enable": 1,
        "list": [
        {"GPIO": {"i2c": 0}, "address": ["0xFF"], "dStay": 0,
        "_address_note": "0xFF = 掃描匯流排上全部並建 0x70 廣播；0x70 = 直接廣播（僅確定 ALLCALL 已開時用）"}
        ]
    },
    "uartMotor": {
        "enable": 0,
        "list": []
    }
}
