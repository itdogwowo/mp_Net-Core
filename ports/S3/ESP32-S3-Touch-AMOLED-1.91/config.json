{
    "scan_ignore": ["/sd"],
    "System": {
        "dual_core_mode": "0",
        "boot_strict": 0,
        "c_lum": 1.0,
        "hostname": "",
        "refresh_rate_ms": 1,
        "master_IP": "",
        "master_port": 0,
        "discovery_port": 9000,
        "heartbeat_interval": 10000,
        "frame_interval_ms": 25,
        "num_pixels": 336,
        "buffer_frames": 1,
        "log_interval_ms": 1000
    },
    "Buffer": {
        "rx_hub_buffers": 16,
        "drop_on_full": 1,
        "drain_reads": 1,
        "fb_mode": "auto"
    },
    "Network": {
        "priority": ["lan", "wifi"],
        "lan": {
            "enable": 0,
            "active_mode": 1,
            "driver": "RMII",
            "phy_addr": 1,
            "phy_type": "IP101",
            "GPIO": {
                "mdc": 31, "mdio": 52, "ref_clk": 50,
                "spi": -1, "cs": -1, "rst": -1, "int": -1
            }
        },
        "wifi": {
            "enable": 0,
            "active_mode": 2,
            "timeout": 300,
            "ssid": "Home_WiFi",
            "ssid_pw": "",
            "mdns_name": "esp32-led-"
        },
        "ESP_now": { "enable": 0, "channel": 6 }
    },
    "CircuitDecode": {
        "enable": 0,
        "list": [
            { "GPIO": { "uart": 0 } }
        ]
    },
    "Router": {
      "enable": 0,
      "routes": []
    },
    "SPI": {
        "enable": 1,
        "list": [
            {
                "id": 1,
                "baudrate": 80000000,
                "phase": 0,
                "polarity": 0,
                "GPIO": { "sck": 47, "mosi": null, "miso": null },
                "data_pins": [18, 7, 48, 5]
            }
        ]
    },
    "I2C": {
        "enable": 1,
        "list": [
            { "id": 0, "freq": 400000, "GPIO": { "scl": 39, "sda": 40 } }
        ]
    },
    "HUSB238": {
        "enable": 0,
        "addr": "0x08",
        "default_voltage": null,
        "GPIO": { "i2c": 0 }
    },
    "UART": {
        "enable": 0,
        "list": []
    },
    "PWM": {
        "enable": 0,
        "list": []
    },
    "ENC": {
        "enable": 0,
        "list": []
    },
    "I2S": {
        "enable": 0,
        "list": []
    },
    "SDcard": {
        "enable": 1,
        "phat": "/sd",
        "config": { "slot": 1, "width": 1, "freq": 20000000 },
        "GPIO": { "sck": 9, "cmd": 42, "data": [8] }
    },
    "PIN": {
        "enable": 1,
        "list": [
            { "GPIO": 6,  "label": "tft_cs",  "mode": "OUT", "initial": 1 },
            { "GPIO": 17, "label": "tft_rst", "mode": "OUT", "initial": 1 },
            { "GPIO": 38, "label": "tft_bl",  "mode": "OUT", "initial": 0 },

            { "GPIO": 10, "label": "m1",      "mode": "OUT", "initial": 0 },
            { "GPIO": 11, "label": "m2",      "mode": "OUT", "initial": 0 },
            { "GPIO": 12, "label": "m_en",    "mode": "OUT", "initial": 0 },

            { "GPIO": 0,  "label": "gp0",     "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 1,  "label": "gp1",     "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 2,  "label": "gp2",     "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 3,  "label": "gp3",     "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 4,  "label": "gp4",     "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 13, "label": "gp13",    "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 14, "label": "gp14",    "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 15, "label": "gp15",    "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 16, "label": "gp16",    "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 21, "label": "gp21",    "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 41, "label": "gp41",    "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 43, "label": "gp43",    "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 44, "label": "gp44",    "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 45, "label": "gp45",    "mode": "IN",  "initial": 0, "pull": "UP" },
            { "GPIO": 46, "label": "gp46",    "mode": "IN",  "initial": 0, "pull": "UP" }
        ]
    },
    "TFT": {
        "enable": 1,
        "driver": "SH8601",
        "width": 536,
        "height": 240,
        "rotation": 0,
        "color_order": "RGB",
        "invert": 0,
        "spi_id": 1,
        "pixel_format": "RGB565_BE",
        "pins": { "dc": "", "cs": "tft_cs", "rst": "tft_rst", "bl": "tft_bl" }
    },
    "WS2812": {
        "enable": 0,
        "list": []
    },
    "APA102": {
        "enable": 0,
        "list": []
    },
    "PCA9685": {
        "enable": 0,
        "list": []
    }
}
