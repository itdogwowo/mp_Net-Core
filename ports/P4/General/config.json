{
    "scan_ignore": ["/sd"],
    "System": {
        "dual_core_mode": "0",
        "boot_strict": 0,
        "c_lum": 1.0,
        "hostname": "",
        "refresh_rate_ms": 1,
        "master_IP": "",
        "master_port": 0,
        "discovery_port": 9000,
        "heartbeat_interval": 10000,
        "frame_interval_ms": 25,
        "num_pixels": 336,
        "buffer_frames": 1,
        "log_interval_ms": 1000
    },
    "Buffer": {
        "rx_hub_buffers": 16,
        "drop_on_full": 1,
        "drain_reads": 1,
        "fb_mode": "auto"
    },
    "Network": {
        "priority": ["lan", "wifi"],
        "lan": {
            "enable": 0,
            "active_mode": 1,
            "driver": "RMII",
            "phy_addr": 1,
            "phy_type": "IP101",
            "GPIO": {
                "mdc": 31, "mdio": 52, "ref_clk": 50,
                "spi": -1, "cs": -1, "rst": -1, "int": -1
            }
        },
        "wifi": {
            "enable": 0,
            "active_mode": 2,
            "timeout": 300,
            "ssid": "Home_WiFi",
            "ssid_pw": "",
            "mdns_name": "esp32-led-"
        },
        "ESP_now": { "enable": 0, "channel": 6 }
    },
    "CircuitDecode": {
        "enable": 0,
        "list": [
            { "GPIO": { "uart": 0 } }
        ]
    },
    "Router": {
      "enable": 0,
      "routes": []
    },

    "SPI": {
        "enable": 1,
        "list": [
            {
                "id": 1,
                "baudrate": 80000000,
                "phase": 0,
                "polarity": 0,
                "GPIO": { "sck": 8, "mosi": null, "miso": null },
                "data_pins": [7]
            }
        ]
    },
    "I2C": {
        "enable": 0,
        "list": [
            { "id": 0, "freq": 400000, "GPIO": { "scl": 8, "sda": 7 } }
        ]
    },
    "HUSB238": {
        "enable": 0,
        "addr": "0x08",
        "default_voltage": null,
        "GPIO": { "i2c": 0 }
    },
    "UART": {
        "enable": 0,
        "list": [
            { "id": 1, "baudrate": 115200, "GPIO": { "tx": 39, "rx": 41 } }
        ]
    },
    "PWM": {
        "enable": 0,
        "list": []
    },
    "ENC": {
        "enable": 0,
        "list": [
            { "id": 0, "GPIO": { "a": 18, "b": 8 } }
        ]
    },
    "I2S": {
        "enable": 0,
        "list": []
    },
    "SDcard": {
        "enable": 1,
        "phat": "/sd",
        "config": { "slot": 0, "width": 4, "freq": 40000000 },
        "GPIO": {
            "_comment": "sck=CLK/SCK, cmd=CMD/MOSI, [D0/MISO, D1/IRQ, D2/NC, D3/CS]",
            "sck": 43, "cmd": 44, "data": [39, 40, 41, 42]
        }
    },
    "PIN": {
        "enable": 0,
        "list": [
            { "GPIO": 47, "label": "tft_cs",  "mode": "OUT", "initial": 1 },
            { "GPIO": 48, "label": "btn",     "mode": "IN",  "initial": 0, "pull": "UP" }
        ]
    },
    "TFT": {
        "enable": 0,
        "driver": "ST7789",
        "width": 240,
        "height": 320,
        "rotation": 0,
        "color_order": "RGB",
        "invert": 0,
        "spi_id": 1,
        "pixel_format": "RGB565_BE",
        "variant": 0,
        "pins": { "dc": "tft_dc", "cs": "tft_cs", "rst": "tft_rst", "bl": "tft_bl" }
    },

    "WS2812": {
        "enable": 0,
        "list": [
            {"GPIO":15,"Q":10,"order":"GRB","dStay":0},
            {"GPIO":16,"Q":10,"order":"GRB","dStay":0},
            {"GPIO":17,"Q":10,"order":"GRB","dStay":0}
        ]
    },
    "APA102": {
        "enable": 0,
         "list": [
            {"GPIO":{"spi":0 },"Q":290,"order":"BGRW","dStay":0}
        ]
    },
    "PCA9685": {
        "enable": 0,
       "list": [
            {"GPIO":{"i2c":0,"type":0},"address":["0x40"],"dStay":0}
        ]
    }
}
